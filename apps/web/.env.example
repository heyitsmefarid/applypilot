# Public values only — these are embedded in the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Never the secret/service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Worker API base URL (wrangler dev → http://localhost:8787)
VITE_API_URL=http://localhost:8787
