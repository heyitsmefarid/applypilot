{
  "name": "@applypilot/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright application runner (GitHub Actions or local) + demo application site",
  "scripts": {
    "run": "tsx src/cli.ts",
    "watch": "tsx src/cli.ts --watch",
    "demo-site": "node demo-site/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@applypilot/core": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15"
  }
}
