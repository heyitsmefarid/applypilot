    {
      "id": "ba286fe4-e9b5-402a-a58e-3af45b01fc14",
      "position": [
        1200,
        200
      ],
      "name": "Run request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "e6bb5a75-6bf5-420e-ae27-48d3409a2046",
      "parameters": {
        "httpMethod": "POST",
        "path": "applypilot/reports",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "apWebhookAuthKey",
          "name": "ApplyPilot Webhook Auth"
        }
      }
    },
    {
      "id": "5a1378cb-1e11-4874-ae68-14d30e56c062",
      "position": [
        240,
        400
      ],
      "name": "Resolve run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Webhook calls carry { run_id, input } from the dispatcher (or push mode); schedules carry neither.\nconst first = $input.first().json;\nconst body = first.body ?? {};\nreturn [{ json: {\n  run_id: body.run_id ?? null,\n  trigger: body.run_id ? 'webhook' : 'schedule',\n  input: body.input ?? {},\n  execution_id: String($execution.id),\n} }];"
      }
    },
    {
      "id": "72eafedd-8255-403d-a069-5dd1afe271eb",
      "position": [
        480,
        400
      ],
      "name": "Start run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLYPILOT_API_URL }}/internal/runs/start",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'reports', run_id: $json.run_id, trigger: $json.trigger, n8n_execution_id: $json.execution_id, input: $json.input }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "apInternalApiKey",
          "name": "ApplyPilot Internal API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "notes": "Creates/claims the run, checks the emergency pause",
      "notesInFlow": true
    },
    {
      "id": "35caabb6-17ec-4fa8-a854-df3ddb504bf9",
      "position": [
        720,
        400
      ],
      "name": "Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nif (!r.proceed) {\n  // Paused, cancelled or already finished: the Worker recorded why. Returning no items ends this execution.\n  return [];\n}\nreturn [{ json: { run_id: r.run.id, input: r.run.input ?? {}, rules: r.rules ?? {} } }];"
      }
    },
    {
      "id": "a5a89568-f656-4f8b-a255-f64ac171a6fa",
      "position": [
        960,
        400
      ],
      "name": "Build report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLYPILOT_API_URL }}/internal/reports/{{ $('Gate').first().json.input.kind || 'daily' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "apInternalApiKey",
          "name": "ApplyPilot Internal API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5e518d8f-3684-4d41-adb0-242059e281e2",
      "position": [
        1200,
        400
      ],
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { status: 'succeeded', stats: { kind: $('Gate').first().json.input.kind || 'daily', emailed: Boolean(r.emailed), telegram: Boolean(r.telegram) }, item_errors: [], text: r.text ?? '', telegram: Boolean(r.telegram) } }];"
      }
    },
    {
      "id": "5e488c89-eb98-4ff6-aede-c9cc418d2c09",
      "position": [
        1680,
        400
      ],
      "name": "Telegram enabled?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $('Summarize').first().json;\n// Sent only when enabled in Settings, a chat id is configured, and there is something to say.\nif (!s.telegram || !s.text || !$env.TELEGRAM_CHAT_ID) return [];\nreturn [{ json: { text: s.text.slice(0, 4000) } }];"
      }
    },
    {
      "id": "07cdc1f4-5161-451f-a786-6ac535534cb1",
      "position": [
        1920,
        400
      ],
      "name": "Send Telegram message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "apTelegramBotKey",
          "name": "ApplyPilot Telegram Bot"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Optional — requires the Telegram credential and TELEGRAM_CHAT_ID",
      "notesInFlow": true
    },
    {
      "id": "a4cd0787-7983-47f4-a084-33caf4219ca1",
      "position": [
        1440,
        400
      ],
      "name": "Finish run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLYPILOT_API_URL }}/internal/runs/{{ $('Gate').first().json.run_id }}/finish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $('Summarize').first().json.status, stats: $('Summarize').first().json.stats, item_errors: $('Summarize').first().json.item_errors ?? [], output: $('Summarize').first().json.output ?? null }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "apInternalApiKey",
          "name": "ApplyPilot Internal API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
