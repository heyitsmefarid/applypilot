      "position": [
        240,
        0
      ],
      "name": "Resolve run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Webhook calls carry { run_id, input } from the dispatcher (or push mode); schedules carry neither.\nconst first = $input.first().json;\nconst body = first.body ?? {};\nreturn [{ json: {\n  run_id: body.run_id ?? null,\n  trigger: body.run_id ? 'webhook' : 'schedule',\n  input: body.input ?? {},\n  execution_id: String($execution.id),\n} }];"
      }
    },
    {
      "id": "1bd1d4af-08bf-47cd-a783-6fa7471319ee",
      "position": [
        480,
        0
      ],
      "name": "Start run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLYPILOT_API_URL }}/internal/runs/start",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'application_submit', run_id: $json.run_id, trigger: $json.trigger, n8n_execution_id: $json.execution_id, input: $json.input }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "apInternalApiKey",
          "name": "ApplyPilot Internal API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "notes": "Creates/claims the run, checks the emergency pause",
      "notesInFlow": true
    },
    {
      "id": "08e1b51c-4f28-4335-a310-1c144f8c9f26",
      "position": [
        720,
        0
      ],
      "name": "Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nif (!r.proceed) {\n  // Paused, cancelled or already finished: the Worker recorded why. Returning no items ends this execution.\n  return [];\n}\nreturn [{ json: { run_id: r.run.id, input: r.run.input ?? {}, rules: r.rules ?? {} } }];"
      }
    },
    {
      "id": "354f68f9-0a1d-4a32-aecb-912950c8aa93",
      "position": [
        240,
        200
      ],
      "name": "Check rules & dispatch runner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLYPILOT_API_URL }}/internal/applications/{{ $('Gate').first().json.input.application_id }}/dispatch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: $('Gate').first().json.input.mode === 'submit' ? 'submit' : 'prefill', run_id: $('Gate').first().json.run_id }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "apInternalApiKey",
          "name": "ApplyPilot Internal API"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Pause, source permission, host allow-list, duplicates, approval and daily cap are all checked here. Never retried automatically (no duplicate submissions).",
      "notesInFlow": true
    },
    {
      "id": "d9943bf0-2719-4292-a8fb-ff68712c846e",
      "position": [
        480,
        200
      ],
      "name": "Dispatch failed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const errOf = (j) => {\n  if (!j || j.error === undefined) return null;\n  const e = j.error;\n  if (typeof e === 'string') return e;\n  return e.message || e.description || JSON.stringify(e).slice(0, 300);\n};\n\nconst err = errOf($input.first().json);\n// On success the runner (GitHub Actions or local) reports back to the Worker, which finishes this run.\nif (!err) return [];\nreturn [{ json: { status: 'failed', stats: {}, item_errors: [], output: { error: err } } }];"
      }
    },
    {
      "id": "bcb8ec94-129e-4c41-a3c4-c2d399fde1e8",
      "position": [
        720,
        200
      ],
      "name": "Mark run failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
