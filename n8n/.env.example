# Copy to .env — never commit the real file.
# Generate secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# n8n core (BACK UP N8N_ENCRYPTION_KEY: stored credentials cannot be decrypted without it)
N8N_ENCRYPTION_KEY=
N8N_JWT_SECRET=
TIMEZONE=Asia/Manila

# Cloudflare Worker API base URL.
#   Local Worker (wrangler dev):  http://host.docker.internal:8787
#   Deployed Worker:              https://applypilot-api.<you>.workers.dev
APPLYPILOT_API_URL=http://host.docker.internal:8787

# Must equal the Worker's INTERNAL_API_TOKEN (min 24 chars). Stored in n8n as an encrypted credential.
APPLYPILOT_INTERNAL_TOKEN=
# Shared secret n8n webhooks require in the X-ApplyPilot-Webhook-Token header
# (equals the Worker's N8N_WEBHOOK_TOKEN if you enable push mode).
APPLYPILOT_WEBHOOK_TOKEN=

# Optional Telegram notifications (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional push mode / remote hosting
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
CLOUDFLARE_TUNNEL_TOKEN=
